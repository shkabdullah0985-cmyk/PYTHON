class user():
  def __init__(self,name,age,gender):
    self.name=name
    self.age=age
    self.gender=gender
  def showdetail(self):
    print("personaldetil:-")
    print(f"name:- {self.name.title()}")
    print("age:-{self.age}")
    print(f"gender:-{self.gender.title()}")
class bank(user):
  __balance=0
  __usercount=0
  def __init__(self,name,age,gender):
    super().__init__(name,age,gender)
    bank.__usercount+=1
    self.accountno=f"denabank0000{bank.__usercount}"
  def ud(self):
    return self.__usercount
  def deposite(self,amount):
    self.amount=amount
    self.__balance+=self.amount
    print(f"account balance is update :- rs {self.__balance}")
  def withdraw(self,amount):
    self.amount=amount
    if(self.amount>self.__balance):
      print(f"insufficient amount,balance available :- rs{self.__balance}")
    elif(100<=self.amount<=self.__balance):
      print("thankyou for visting")
      self.__balance-=self.amount
      print(f"current balance is:- rs {self.__balance}")
    else:
      print(f"you cannot withdraw less than rs.100")
  def viewbalance(self):
    self.showdetail()
    print(f"accountno:- {self.accountno}")
    print(f"current balance is:- {self.__balance}")
  def transfer(self,username,amount):
    self.amount=amount
    if(self.amount>self.__balance):
      print(f"insufficent amount ,balance available:-{self.__balance}")
    elif(1<self.amount<=self.__balance):
      username.__balance+=self.amount
      self.__balance-=self.amount
      print("amount transfer succesfully")
      print(f"current balance is :- {self.__balance}")
    else:
      print("you cannot transfer less than:- rs.1")
